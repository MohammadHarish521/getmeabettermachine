# Public origin used for Dodo return/cancel URLs and metadata.
# Local: http://localhost:3000
# Production: https://your-domain.com
APP_URL=http://localhost:3000

# SQLite file. On hosts with an ephemeral filesystem, point this at a
# mounted volume or every deploy wipes sponsors and payments.
DB_PATH=./data/raise-my-mac.db

# Hosted SQLite for production. When both are set, the app uses Turso
# instead of the local file. Leave blank locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin
# The /admin UI is closed until ADMIN_PASSWORD is set.
ADMIN_PASSWORD=
# Optional. Used to sign the admin session cookie. Falls back to ADMIN_PASSWORD.
ADMIN_SECRET=

# Dodo Payments
# Leave blank to use the local mock checkout.
# Create a one-time product with Pay What You Want enabled (min $1).
# Test and live keys/products/webhooks are separate — do not mix them.
# Use a dedicated product for this site. Do not reuse gethigh.today IDs.
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode
# Local: test_mode. Production must use live_mode plus Live-dashboard keys.
DODO_PAYMENTS_ENV=test_mode

# DataFast. Public website id for www.raisemymini.com. Safe in the browser.
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=dfid_B3o3P3Z0FETAZbOhZRj49
# Website key from DataFast → Website Settings → API. Server only.
# When set, a successful Dodo payment is reported for revenue attribution.
DATAFAST_API_KEY=
